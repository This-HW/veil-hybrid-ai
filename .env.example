# Firebase web app configuration — public client identifiers.
# Create a Firebase project, add a Web app, and copy the values from
# Project settings > Your apps > SDK setup and configuration.
# These are not secrets (they ship in every Firebase web bundle); the Gemini API
# is protected by App Check, which is enforced for AI Logic.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check with reCAPTCHA v3 (use this for a hosted build).
# Create a reCAPTCHA v3 site key for your domain in the reCAPTCHA admin console
# and register it under App Check > Apps > (your web app) > reCAPTCHA v3.
VITE_RECAPTCHA_SITE_KEY=

# GitHub Pages base path, e.g. /veil-hybrid-ai/ . Leave empty for localhost.
# VITE_BASE=/
